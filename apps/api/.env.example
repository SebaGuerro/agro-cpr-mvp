# ---------- local development (no Supabase, no chain) ----------
NODE_ENV=development
PORT=3001
DATABASE_URL=pglite:./.data/pg
AUTH_MODE=dev
STORAGE_MODE=local
CHAIN_MODE=mock
# 32+ random characters. Must never change once the pilot starts: on-chain keys derive from it.
LEDGER_KEY_SECRET=change-me-change-me-change-me-change-me
DELIVERY_TOLERANCE_BPS=200
# Imported events wait this long before anchoring: the window to roll back a wrong file.
IMPORT_HOLD_MINUTES=30
CORS_ORIGINS=http://localhost:3000

# ---------- production (Fly.io secrets) ----------
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
# AUTH_MODE=supabase
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_JWT_SECRET=            # only if the project still uses the legacy shared JWT secret
# STORAGE_MODE=supabase
# SUPABASE_SERVICE_ROLE_KEY=
# STORAGE_BUCKET=evidence
# CHAIN_MODE=base-sepolia
# BASE_SEPOLIA_RPC_URL=https://base-sepolia.g.alchemy.com/v2/<key>
# RELAYER_PRIVATE_KEY=0x...
# AGRO_LEDGER_ADDRESS=0x...
