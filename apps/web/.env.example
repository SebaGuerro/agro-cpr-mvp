# Backend base URL (apps/api). Locally: npm run dev -w @agro-cpr/api
VITE_API_URL=http://localhost:3001
# "dev" shows a picker of the seeded users (needs the API in AUTH_MODE=dev); "supabase" uses email login.
VITE_AUTH_MODE=dev
# Only for VITE_AUTH_MODE=supabase (the public anon key, never the service role key)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Block explorer for transaction links
VITE_EXPLORER_TX_URL=https://sepolia.basescan.org/tx/
