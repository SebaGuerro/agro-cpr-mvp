# Copy to .env (never commit .env). Load with: set -a; source .env; set +a
BASE_SEPOLIA_RPC_URL=https://base-sepolia.g.alchemy.com/v2/<ALCHEMY_KEY>
# One Etherscan API v2 key covers Basescan.
ETHERSCAN_API_KEY=
# 2-of-3 Safe on Base Sepolia: DEFAULT_ADMIN_ROLE (grant/revoke roles, pause).
ADMIN_SAFE_ADDRESS=
# Address of the backend relayer EOA. Its private key lives only in the backend's secret store.
RELAYER_ADDRESS=
# Optional; defaults to the Safe. Receives the soulbound CPR tokens.
CUSTODY_ADDRESS=
